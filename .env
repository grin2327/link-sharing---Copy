# ===== ENVIRONMENT CONFIGURATION =====
NODE_ENV=development
PORT=3000

# ===== SECURITY - CRITICAL! GENERATE NEW VALUES =====
# Generate SESSION_SECRET using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then replace dev-secret below with the generated value
SESSION_SECRET=3d4f8a2c1e9b5f7a0d3c6e9b2f5a8d1c4e7f0a3d6c9b2e5f8a1d4e7c0a3b6

# Default Admin Credentials - CHANGE ON FIRST LOGIN!
# Password must have: 12+ chars, 1 uppercase, 1 lowercase, 1 number, 1 special char (@$!%*?&)
ADMIN_PASSWORD=Admin@Password123

# ===== CORS & ORIGIN CONFIGURATION =====
# For localhost development: http://localhost:3000
# For production: https://your-domain.com
CORS_ORIGIN=http://localhost:3000

# ===== SECURITY SETTINGS =====
# Set to true when using HTTPS in production
SECURE_COOKIE=false
FORCE_HTTPS=false

# ===== RATE LIMITING =====
# Global rate limit: 100 requests per 15 minutes (900000ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Login protection: 5 attempts per 15 minutes → 15 minute lockout
LOGIN_ATTEMPT_LIMIT=5
